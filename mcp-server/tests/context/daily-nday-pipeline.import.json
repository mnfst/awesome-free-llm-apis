          -1600,
          100
        ]
      },
      {
        "parameters": {
          "conditions": {
            "boolean": [
              {
                "value1": "={{$json.skip}}",
                "value2": true
              }
            ]
          }
        },
        "id": "filter-skip",
        "name": "Filter Skip",
        "type": "n8n-nodes-base.if",
        "typeVersion": 1,
        "position": [
          -1450,
