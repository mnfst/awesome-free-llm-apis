          -400,
          100
        ]
      },
      {
        "id": "summary",
        "name": "Final Summary",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -100,
          300
        ],
        "parameters": {
          "jsCode": "const allProcessed = [];\ntry {\n  const results = $items(\"Save Report\");\n  results.forEach(item => {\n    if (item.json && item.json.cve_id) {\n      allProcessed.push({\n        cve_id: item.json.cve_id,\n        score: item.json.cvss_score || 0,\n        confidence: item.json.confidence || 0,\n        path: (item.json.paths && item.json.paths.length > 0) ? item.json.paths[0] : \"\"\n      });\n    }\n  });\n} catch (e) {\n  console.error('Summary error:', e);\n}\n\nconst ingest_run_id = $(\"CVE Ingest\").first().json.ingest_run_id || \"\";\nconst highCount = allProcessed.filter(c => c.score >= 8.0 || c.confidence >= 0.8).length;\n\nreturn [{\n  json: {\n    date: new Date().toISOString().split('T')[0],\n    total_processed: allProcessed.length,\n    high_confidence: highCount,\n    ingest_run_id: ingest_run_id,\n    successful_ids: allProcessed.map(c => c.cve_id),\n    reports: allProcessed\n  }\n}];"
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://rag-service:9000/cve/ingest/commit",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"ingest_run_id\": \"{{ $json.ingest_run_id }}\",\n  \"processed_count\": {{ $json.total_processed }},\n  \"successful_ids\": {{ JSON.stringify($json.successful_ids) }},\n  \"allow_partial\": true\n}",
          "options": {}
        },
        "id": "commit-ingest",
        "name": "Commit Ingest",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
