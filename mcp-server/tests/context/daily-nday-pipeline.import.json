      {
        "parameters": {
          "method": "POST",
          "url": "http://rag-service:9000/cve/ingest",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"reset\": {{ $execution.mode === 'manual' }},\n  \"force\": {{ $execution.mode === 'manual' }}\n}",
          "options": {}
        },
        "id": "ingest-http",
        "name": "CVE Ingest",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          -2200,
          100
        ]
      },
      {
        "parameters": {
          "jsCode": "const data = $json;\nconst ingest_run_id = data.ingest_run_id || \"\";\nconst cves = data.cves || [];\n\nif (cves.length === 0) {\n  return [{ json: { skip: true, cve_id: 'NONE', ingest_run_id } }];\n}\n\nreturn cves.map(cve => ({\n  json: {\n    ...cve,\n    skip: false,\n    ingest_run_id: ingest_run_id\n  }\n}));"
        },
        "id": "prepare_loop",
        "name": "Prepare Loop",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -1900,
          100
        ]
      },
