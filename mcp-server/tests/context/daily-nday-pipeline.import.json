          -1150,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://ollama:11435/api/chat",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { model: 'qwen3:4b-q4_K_M', messages: [ { role: 'system', content: 'You are an expert N-Day researcher. Generate a detailed report. End with a confidence score like \"Confidence: 0.8\".' }, { role: 'user', content: $json.rag_data?.prompt || $json.rag_data?.llm_prompt || 'Analyze raw CVE: ' + JSON.stringify($json) } ], options: { num_ctx: 16384, temperature: 0.2 }, stream: false } }}",
          "options": {
            "response": {
              "response": {
                "responseFormat": "json",
                "putResponseInProperty": true,
                "responsePropertyName": "ollama_raw"
              }
            }
          }
        },
        "id": "ollama-code",
        "name": "Ollama Analysis",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          -1000,
          200
        ]
      },
      {
        "parameters": {
          "jsCode": "const input = $json;\nconst loopItem = $(\"Loop Node\").first().json || {};\n\nconst cve_id = input.cve_id || loopItem.cve_id || 'UNKNOWN';\nconst cvss_score = input.cvss_score || loopItem.cvss_score || 0;\nconst ingest_run_id = input.ingest_run_id || loopItem.ingest_run_id || '';\n\nlet ollama_text = '';\nlet confidence = 0.5;\n\nconst is_zero_day = input.rag_data?.zero_day === true;\n\nif (is_zero_day) {\n  ollama_text = `# Zero-Day Vulnerability Analysis: ${cve_id}\\n\\nThis vulnerability has been flagged as a Zero-Day (no patch available). Standard LLM N-Day analysis is skipped.`;\n  confidence = 1.0;\n} else {\n  const ollama_raw = input.ollama_raw || input || {};\n  ollama_text = ollama_raw.message?.content || ollama_raw.response || '';\n  \n  if (ollama_text) {\n    const confidenceMatch = ollama_text.match(/Confidence:\\\\s*(0\\\\.\\\\d+|1\\\\.0|1|\\\\.\\\\d+)/i);\n    if (confidenceMatch) {\n      confidence = parseFloat(confidenceMatch[1]);\n    } else {\n      const fallbackMatch = ollama_text.match(/(\\\\d+(\\\\.\\\\d+)?)%?\\\\s*confidence/i);\n      if (fallbackMatch) confidence = parseFloat(fallbackMatch[1]) / (fallbackMatch[1].includes('%') || parseFloat(fallbackMatch[1]) > 1 ? 100 : 1);\n    }\n  } else {\n    ollama_text = 'Error: Analysis returned empty.';\n  }\n}\n\nreturn [{\n  json: {\n    cve_id,\n    cvss_score,\n    confidence,\n    llm_report: ollama_text,\n    ingest_run_id\n  }\n}];"
        },
        "id": "extract-meta",
        "name": "Extract Metadata",
        "type": "n8n-nodes-base.code",
