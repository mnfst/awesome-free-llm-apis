# Provider API Keys
CO_API_KEY=your_cohere_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
GITHUB_TOKEN=your_github_token_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
LLM7_API_KEY=your_llm7_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
KILO_API_KEY=your_kilo_api_key_here
MODELSCOPE_API_KEY=your_modelscope_api_key_here

# Server Configuration
PORT=3000
LOG_LEVEL=info
MEMORY_STORE_PATH=./data/memory.json
NODE_ENV=development
DEBUG=
CACHE_STORE_PATH=./data/cache.json
# Path where LLMExecutor's local usage snapshot is persisted; defaults next to the package if unset
MCP_USAGE_PATH=
# How often (ms) LLMExecutor flushes usage stats to MCP_USAGE_PATH
LOCAL_PERSIST_INTERVAL_MS=60000
# Hex-encoded key used to encrypt persisted secrets (utils/encryption.ts). Leave unset to
# use the built-in fallback key (fine for local/dev, generate your own for anything shared).
MCP_SECRET_KEY=
# Absolute path to a Python executable, if auto-detection of the Gemini CLI's Python
# interpreter needs to be overridden.
PYTHON_EXECUTABLE=

# Agentic Subtask Execution
# Master switch for AgenticMiddleware's task-decomposition/session-memory pipeline. Callers
# can still opt in per-request via `agentic: true` on use_free_llm even when this is unset.
ENABLE_AGENTIC_MIDDLEWARE=false
# Wall-clock budget (ms) for a single use_free_llm agentic call before it yields a partial
# result + resume handle and continues the remaining subtasks in the background. Keep this
# under your MCP client's tool-call timeout (many code editors default to ~30s).
MCP_SUBTASK_BUDGET_MS=20000

# Browser Tool
# Delay (ms) between replayed browser actions in checkpoint/session replay.
BROWSER_REPLAY_DELAY_MS=250
# Overrides for where each agent's artifact files are read from (used by pdf/artifact://
# reference resolution). Defaults to well-known per-agent home-directory locations if unset.
CLAUDE_ARTIFACTS_DIR=
CHATGPT_ARTIFACTS_DIR=
CODEX_ARTIFACTS_DIR=
ANTIGRAVITY_APP_DATA=
# Path to the external agent-prompt directory used by AgenticMiddleware's prompt loader.
AGENT_PROMPT_PATH=

# Wiki / PDF Indexing Tuning (all optional — sane defaults baked into src/config/wiki-config.ts)
WIKI_MODEL_CONTEXT_K=8
WIKI_MAX_PAGES=500
WIKI_MAX_TOKENS=2000
WIKI_DIFF_CHARS=4000
WIKI_CANDIDATES=15
WIKI_KEYWORDS=8
PDF_BATCH_THRESHOLD=5
PDF_CHUNK_SIZE=600
PDF_CHUNK_OVERLAP=120
PDF_RAG_TOP_K=8
PDF_RAG_TOP_K_CEILING=40
PDF_MAX_PAGES=100000
PDF_RAG_QUERY_CHARS=400
# Similarity threshold used by context-gatherer's log-compaction pass. Unset uses a
# per-extension default (0.55 for .md/.txt, 0.82 otherwise).
LOG_COMPACTION_THRESHOLD=


